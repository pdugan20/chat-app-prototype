# Public, non-secret URL embedded in the Expo app
EXPO_PUBLIC_AI_PROXY_URL=http://127.0.0.1:8787

# Private values read only by the local Node process
AI_PROVIDER=anthropic
AI_OPENAI_MODEL=gpt-5.6-luna
AI_ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROXY_PORT=8787
AI_PROXY_TIMEOUT_MS=20000

# Apple Music
EXPO_PUBLIC_APPLE_MUSIC_TOKEN=

# Apple Music token generation (keep the .p8 file outside the repository)
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_FILE=
