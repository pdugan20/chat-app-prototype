{
  "expo": {
    "name": "iMessage-Prototype",
    "slug": "iMessage-Prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "reactCompiler": true
    },
    "platforms": ["ios"],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.example.chatapp",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "UIStatusBarStyle": "UIStatusBarStyleDefault",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIDesignRequiresCompatibility": true,
        "LSApplicationQueriesSchemes": ["music", "itmss", "itms-apps"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "6359a694-e6ea-4469-8d9a-5ea15e97cafd"
      }
    },
    "plugins": [
      "expo-audio",
      [
        "expo-dev-client",
        {
          "ios": {
            "toolsButton": false,
            "skipOnboarding": true,
            "showMenuAtLaunch": false
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-asset",
      "expo-font"
    ]
  }
}
