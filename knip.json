{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["App.tsx", "scripts/*.{js,ts}"],
  "ignore": [".rnstorybook/storybook.requires.ts"],
  "ignoreDependencies": [
    "babel-loader",
    "@semantic-release/commit-analyzer",
    "@semantic-release/github",
    "@semantic-release/npm",
    "@semantic-release/release-notes-generator",
    "conventional-changelog-conventionalcommits",
    "expo-updates",
    "@eslint/js",
    "@expo/metro-config",
    "babel-preset-expo",
    "metro-minify-terser",
    "lint-staged"
  ],
  "ignoreBinaries": ["actionlint", "zizmor"]
}
