{
  "name": "imessage-prototype",
  "version": "1.1.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": "11.x"
  },
  "packageManager": "npm@11.5.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "npm run test:storybook-boundary && npm run test:ai-proxy && npm run test:apple-token && jest --ci --coverage --maxWorkers=2",
    "test:automation-policy": "node --test scripts/automation-policy.test.mjs",
    "generate-apple-token": "node scripts/generate-apple-music-token.js",
    "setup-hooks": "chmod +x scripts/setup-hooks.sh .githooks/pre-commit .githooks/pre-push && ./scripts/setup-hooks.sh",
    "sb": "STORYBOOK_ENABLED=true expo start --dev-client",
    "sb:ios": "STORYBOOK_ENABLED=true expo start --dev-client --ios",
    "sb:generate": "sb-rn-get-stories",
    "android": "expo run:android",
    "markdownlint:fix": "markdownlint '**/*.md' --ignore node_modules --ignore CHANGELOG.md --ignore ios --ignore android --fix",
    "test:ai-proxy": "node --test server/ai-proxy/config.test.mjs server/ai-proxy/providers.test.mjs server/ai-proxy/handler.test.mjs scripts/ai-security-boundary.test.mjs",
    "ai-proxy": "node server/ai-proxy/index.mjs",
    "knip": "knip",
    "markdownlint": "markdownlint '**/*.md' --ignore node_modules --ignore CHANGELOG.md --ignore ios --ignore android",
    "doctor": "EXPO_OFFLINE=1 expo-doctor",
    "verify": "actionlint && zizmor --offline --min-severity medium . && npm run test:automation-policy && npm run format:check && npm run lint && tsc --noEmit --skipLibCheck && npm run markdownlint && npm run knip && npm run test:ci && expo install --check && expo prebuild --platform ios --no-install --clean && expo export --platform ios",
    "test:storybook-boundary": "node --test scripts/storybook-boundary.test.mjs",
    "test:apple-token": "node --test scripts/generate-apple-music-token.test.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,jsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write",
      "markdownlint --ignore node_modules --ignore CHANGELOG.md"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@expo/ui": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native-community/slider": "5.2.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "dotenv": "^17.4.2",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "openai": "^7.3.0",
    "react": "19.2.3",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@react-native/jest-preset": "^0.86.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@storybook/addon-ondevice-actions": "10.7.1",
    "@storybook/addon-ondevice-backgrounds": "10.7.1",
    "@storybook/addon-ondevice-controls": "10.7.1",
    "@storybook/addon-ondevice-notes": "10.7.1",
    "@storybook/react": "10.6.6",
    "@storybook/react-native": "10.7.1",
    "@storybook/react-native-theming": "10.7.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "babel-loader": "^8.4.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "jsonwebtoken": "^9.0.3",
    "knip": "^5.83.1",
    "lint-staged": "^16.2.7",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.6.2",
    "react-dom": "19.2.3",
    "semantic-release": "^25.0.8",
    "storybook": "10.6.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "postcss": "^8.5.10",
    "@xmldom/xmldom": "^0.8.13",
    "flatted": "^3.4.2",
    "glob": "^11.1.0",
    "handlebars": "^4.7.9",
    "jws": "^3.2.3",
    "lodash": "^4.18.0",
    "lodash-es": "^4.18.0",
    "minimatch": "^10.2.3",
    "picomatch": "^4.0.4",
    "tar": "^7.5.11",
    "brace-expansion": "^5.0.5",
    "ip-address": "^10.1.1",
    "js-yaml": "^4.3.0",
    "yaml": "^2.8.3",
    "test-exclude": {
      "glob": "^7.1.4",
      "minimatch": "^3.0.4"
    }
  }
}
